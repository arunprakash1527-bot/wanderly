# Anthropic Claude API key — get one from the Claude console (https://console.anthropic.com).
# Never commit your real key. Copy this file to `.env.local` and fill it in.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default Claude model (defaults to claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override the SQLite database file path (defaults to ./data/tnpsc.db).
# DATABASE_PATH=./data/tnpsc.db
