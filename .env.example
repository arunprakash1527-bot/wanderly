# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. In production set these in Vercel → Settings
# → Environment Variables. Never commit real secrets.
# ---------------------------------------------------------------------------

# Anthropic Claude API key — used server-side for all AI features.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
# Optional model override (defaults to claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Database. Local dev defaults to a local file if these are unset.
# Production: create a Turso DB (https://turso.tech) and paste its URL + token.
# TURSO_DATABASE_URL=libsql://your-db-name-you.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# Auth.js (NextAuth v5). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string
# Google OAuth client (https://console.cloud.google.com → Credentials).
AUTH_GOOGLE_ID=xxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxx
# On Vercel, also set AUTH_URL to your deployed URL, e.g.
# AUTH_URL=https://your-app.vercel.app
